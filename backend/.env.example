# ---- Copy to .env and adjust. All values are optional; defaults run locally. ----

# General
ENV=local
LOG_LEVEL=INFO

# Persistence
#   Local default (no DB needed):  sqlite+aiosqlite:///./orchestrator.db
#   Docker Compose sets Postgres:  postgresql+asyncpg://orch:orch@db:5432/orchestrator
DATABASE_URL=sqlite+aiosqlite:///./orchestrator.db

# Live-monitoring event bus. Leave blank to use the in-process bus.
# Docker Compose sets: redis://redis:6379/0
REDIS_URL=

# ---- LLM provider (pluggable) ----
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI OR any OpenAI-compatible gateway (hosted vLLM, Ollama-OpenAI, etc.).
# Example — a hosted Qwen endpoint:
#   DEFAULT_PROVIDER=openai
#   DEFAULT_MODEL=qwen3.6_35b
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://your-gateway/v1
#   OPENAI_TIMEOUT=180
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT=180
# Qwen/vLLM reasoning mode. Off = fast, short replies (recommended). Only
# applies when OPENAI_BASE_URL points at a Qwen/vLLM gateway.
# ENABLE_THINKING=false

# ANTHROPIC_API_KEY=

# ---- Runtime guardrails ----
MAX_WORKFLOW_STEPS=40
LLM_TIMEOUT_SECONDS=120

# ---- Telegram channel ----
# Get a token from @BotFather, then set it here and restart.
TELEGRAM_BOT_TOKEN=
ENABLE_TELEGRAM=true
# Optionally pin inbound messages to ONE of these (or bind in the UI → Settings/Channels).
# TELEGRAM_AGENT_ID=
# TELEGRAM_WORKFLOW_ID=

# ---- Slack channel (Socket Mode — no public webhook needed) ----
# 1) Create an app at api.slack.com/apps. 2) Enable Socket Mode + generate an
#    app-level token (xapp-, scope connections:write). 3) Add bot scopes
#    app_mentions:read, chat:write, im:history, im:read, then install to the workspace.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
ENABLE_SLACK=true
# SLACK_AGENT_ID=
# SLACK_WORKFLOW_ID=
